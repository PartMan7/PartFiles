		"/directories": {
			"get": {
				"tags": ["Admin"],
				"summary": "List allowed directories",
				"description": "Returns a list of directories allowed for storage. **Requires Admin role.**",
				"responses": {
					"200": {
						"description": "List of directories",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"properties": {
										"directories": {
											"type": "array",
											"items": {
												"type": "string"
											}
										}
									}
								}
							}
						}
					},
					"403": {
						"description": "Forbidden",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},
		"/tokens": {
			"get": {
				"tags": ["Tokens"],
				"summary": "List your tokens (never includes secrets)",
				"responses": {
					"200": {
						"description": "OK",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"properties": {
										"tokens": {
											"type": "array",
											"items": {
												"type": "object",
												"properties": {
													"id": {
														"type": "string"
													},
													"name": {
														"type": "string"
													},
													"prefix": {
														"type": "string"
													},
													"scopes": {
														"type": "array",
														"items": {
															"type": "string",
															"enum": ["me", "upload", "user"]
														}
													},
													"expiresAt": {
														"type": "string",
														"format": "date-time",
														"nullable": true
													},
													"lastUsedAt": {
														"type": "string",
														"format": "date-time",
														"nullable": true
													},
													"revokedAt": {
														"type": "string",
														"format": "date-time",
														"nullable": true
													},
													"createdAt": {
														"type": "string",
														"format": "date-time"
													}
												}
											}
										}
									}
								}
							}
						}
					},
					"403": {
						"description": "Guest",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					},
					"401": {
						"description": "Unauthorized",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			},
			"post": {
				"tags": ["Tokens"],
				"summary": "Create a token; the secret is returned once",
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"required": ["name", "scopes", "expiresInDays"],
								"properties": {
									"name": {
										"type": "string",
										"maxLength": 60
									},
									"scopes": {
										"type": "array",
										"items": {
											"type": "string",
											"enum": ["me", "upload", "user"]
										}
									},
									"expiresInDays": {
										"type": "integer",
										"nullable": true,
										"enum": [1, 7, 30, 90, 365, null],
										"description": "null = permanent until revoked"
									}
								}
							}
						}
					}
				},
				"responses": {
					"201": {
						"description": "Created; `token` is shown once",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"properties": {
										"token": {
											"type": "string"
										},
										"info": {
											"type": "object",
											"properties": {
												"id": {
													"type": "string"
												},
												"name": {
													"type": "string"
												},
												"prefix": {
													"type": "string"
												},
												"scopes": {
													"type": "array",
													"items": {
														"type": "string",
														"enum": ["me", "upload", "user"]
													}
												},
												"expiresAt": {
													"type": "string",
													"format": "date-time",
													"nullable": true
												}
											}
										}
									}
								}
							}
						}
					},
					"400": {
						"description": "Invalid input",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					},
					"403": {
						"description": "Guest, or scope not grantable",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					},
					"409": {
						"description": "Active token limit",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					},
					"429": {
						"description": "Rate limited",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					},
					"401": {
						"description": "Unauthorized",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},
		"/tokens/{id}": {
			"delete": {
				"tags": ["Tokens"],
				"summary": "Revoke a token (immediate)",
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"200": {
						"description": "Revoked",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Success"
								}
							}
						}
					},
					"404": {
						"description": "Not found",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		}
	},
	"components": {
		"securitySchemes": {
			"bearerAuth": {
				"type": "http",
				"scheme": "bearer",
				"description": "Token from /tokens; scope required per endpoint."
			}
		},
		"schemas": {
			"Error": {
				"type": "object",
				"properties": {
					"error": {
						"type": "string"
					}
				}
			},
			"Success": {
				"type": "object",
				"properties": {
					"success": {
						"type": "boolean"
					}
				}
			},
			"User": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"username": {
						"type": "string"
					},
					"role": {
						"type": "string",
						"enum": ["guest", "uploader", "admin"]
					},
					"createdAt": {
						"type": "string",
						"format": "date-time"
					},
					"updatedAt": {
						"type": "string",
						"format": "date-time"
					},
					"_count": {
						"type": "object",
						"properties": {
							"content": {
								"type": "integer"
							}
						}
					}
				}
			},
			"Content": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"filename": {
						"type": "string"
					},
					"originalFilename": {
						"type": "string"
					},
					"directory": {
						"type": "string",
						"nullable": true
					},
					"fileSize": {
						"type": "integer"
					},
					"fileExtension": {
						"type": "string"
					},
					"mimeType": {
						"type": "string"
					},
					"expiresAt": {
						"type": "string",
						"format": "date-time",
						"nullable": true
					},
					"createdAt": {
						"type": "string",
						"format": "date-time"
					},
					"hasPreview": {
						"type": "boolean"
					},
					"uploadedBy": {
						"type": "object",
						"properties": {
							"id": {
								"type": "string"
							},
							"username": {
								"type": "string"
							},
							"role": {
								"type": "string"
							}
						}
					},
					"shortSlugs": {
						"type": "array",
						"items": {
							"type": "object",
							"properties": {
								"slug": {
									"type": "string"
								}
							}
						}
					}
				}
			},
			"UploadResult": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"filename": {
						"type": "string"
					},
					"directory": {
						"type": "string",
						"nullable": true,
						"description": "Admin upload only"
					},
					"shortSlugs": {
						"type": "array",
						"items": {
							"type": "string"
						},
						"description": "Admin upload only"
					},
					"size": {
						"type": "integer"
					},
					"expiresAt": {
						"type": "string",
						"format": "date-time",
						"nullable": true
					},
					"url": {
						"type": "string"
					},
					"shortUrl": {
						"type": "string",
						"nullable": true,
						"description": "Admin upload only"
					},
					"rawUrl": {
						"type": "string"
					}
				}
			}
		}
	}
}
