		"/content": {
			"get": {
				"tags": ["Admin", "Uploader"],
				"summary": "List content",
				"description": "Lists content. Admins may see all items (optional filters). Other roles must pass `uploadedBy` query params scoped to their username; the server enforces access. Bearer scope: `me`.",
				"parameters": [
					{
						"name": "expired",
						"in": "query",
						"schema": {
							"type": "string",
							"enum": ["active", "expired"]
						}
					},
					{
						"name": "uploadedBy",
						"in": "query",
						"description": "Repeat for multiple tags (admin filter; required for non-admins).",
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"200": {
						"description": "List of content",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"properties": {
										"content": {
											"type": "array",
											"items": {
												"$ref": "#/components/schemas/Content"
											}
										}
									}
								}
							}
						}
					},
					"400": {
						"description": "Invalid uploader filter",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					},
					"401": {
						"description": "Not authenticated",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				},
				"security": [
					{
						"bearerAuth": []
					}
				]
			}
		},
		"/admin/content/{id}": {
			"get": {
				"tags": ["Admin"],
				"summary": "Get content metadata",
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"200": {
						"description": "Content details",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"properties": {
										"content": {
											"$ref": "#/components/schemas/Content"
										}
									}
								}
							}
						}
					},
					"403": {
						"description": "Forbidden",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					},
					"404": {
						"description": "Content not found",
						"content": {
